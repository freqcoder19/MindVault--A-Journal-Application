# ==============================================================================
# MINDVAULT ENVIRONMENT CONFIGURATION (TEMPLATE / PLACEHOLDERS ONLY)
# Never commit real secrets, private keys, or credentials to this repository.
# ==============================================================================

# Gemini Authentication Mode:
# Production uses Google Cloud Vertex AI with Application Default Credentials (ADC) and IAM.
# Secret Manager can be used as standby (no hardcoded keys required).
MINDVAULT_GEMINI_AUTH_MODE=VERTEX_AI_ADC
GOOGLE_CLOUD_LOCATION=global
NODE_ENV=production

# Google Cloud & Firestore Project Identifiers
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT_ID
FIRESTORE_DATABASE_ID=YOUR_FIRESTORE_DATABASE_ID

# Hosted Service URL (injected automatically in Cloud Run)
APP_URL=YOUR_APP_URL

# Optional: Firebase App Check enforcement ('off' | 'audit' | 'enforce')
MINDVAULT_APPCHECK_ENFORCEMENT=off


